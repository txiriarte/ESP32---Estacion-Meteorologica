{
  "expo": {
    "name": "Estacion IAQ",
    "slug": "estacion-iaq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xirius.estacioniaq"
    },
    "android": {
      "package": "com.xirius.estacioniaq",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icono-192.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "972b6eb2-b132-4d02-a16a-7ac7e190579a"
      }
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
